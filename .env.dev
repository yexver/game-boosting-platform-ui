# 页面标题
VITE_APP_TITLE = '游戏代练平台'

# 开发环境配置
VITE_ENV = 'development'

# 后台指代路径
VITE_APP_BASE_API = '/api'

# 路由懒加载
VITE_CLI_BABEL_TRANSPILE_MODULES = true


# 图片访问基地址
VITE_APP_IMG_BASE_URL = 'https://game-boosting.oss-cn-guangzhou.aliyuncs.com/'

# WebSocket：直连独立 WebSocket 服务（端口 8888），不走网关
VITE_APP_WS_URL = 'ws://127.0.0.1:8888/ws'
